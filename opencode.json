{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"github-copilot": {
			"models": {
				"claude-sonnet-4-6": {
					"name": "Claude Sonnet 4.6 (Copilot)"
				},
				"claude-sonnet-4-5": {
					"name": "Claude Sonnet 4.5 (Copilot)"
				},
				"claude-opus-4-5": {
					"name": "Claude Opus 4.5 (Copilot)"
				}
			}
		}
	},
	"model": "github-copilot/claude-sonnet-4-6",
	"lsp": {
		"clangd": {
			"command": ["/home/work/.local/bin/clangd"]
		},
		"csharp": {
			"command": ["/home/work/.local/omnisharp/OmniSharp", "-lsp"],
			"env": {
				"DOTNET_ROOT": "/home/work/.dotnet"
			}
		},
		"pyright": {
			"command": ["/home/work/.nvm/versions/node/v24.15.0/bin/pyright-langserver", "--stdio"]
		},
		"gdscript": {
			"command": ["godot", "--editor", "--path", "modules/gdscript/tests/scripts", "--lsp-port", "6005"],
			"extensions": [".gd"]
		}
	}
}
